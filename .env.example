# --- Dify 目标版本（仅在升级冒烟测试通过后 bump）---
DIFY_TARGET_VERSION=1.17.0

# Dify nginx 入口地址（console API 在 <base>/console/api，service API 在 <base>/v1）
DIFY_BASE_URL=http://localhost

# --- Console API 鉴权：二选一 ---
# 策略 A（推荐）：Admin API Key。需在 Dify 环境变量开启（不是源码）：
#   ADMIN_API_KEY_ENABLE=true
#   ADMIN_API_KEY=<强随机串>
DIFY_ADMIN_API_KEY=
# 工作区（tenant）id：从 Dify 数据库 tenants.id 或登录态工作区列表获取
DIFY_WORKSPACE_ID=

# 策略 B（备用）：邮箱密码 Cookie 会话。密码以 base64 编码传输。
DIFY_EMAIL=
DIFY_PASSWORD=

# --- HTTP ---
HTTP_TIMEOUT=60.0

# --- 安全 / 加固 ---
# 用于派生敏感 token（Dify Service API token）落库加密密钥，生产必须换成强随机值
SECRET_KEY=dev-insecure-change-me
# 公开 run API 每 key 每分钟请求上限（<=0 关闭）
RATE_LIMIT_PER_MINUTE=60

# --- OpenAPI → MCP 桥接 ---
# 返回给调用方的 MCP 服务地址所用的主机（部署时设为机器可达 IP/域名）
MCP_PUBLIC_HOST=127.0.0.1
# MCP worker 绑定主机（0.0.0.0 = 所有网卡）
MCP_BIND_HOST=0.0.0.0
# MCP streamable-http 挂载路径
MCP_PATH=/mcp
