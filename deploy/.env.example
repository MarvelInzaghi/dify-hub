# dify-hub production environment. Fill in the Dify connection + secrets for the
# target environment before `docker compose up -d`.

# --- Dify connection (console API at <base>/console/api, service API at <base>/v1) ---
# Same-host Dify: http://host.docker.internal
# Remote Dify:     http://<dify-host>:80
DIFY_BASE_URL=http://host.docker.internal

# Console API auth — Strategy A (admin API key). Requires Dify env:
#   ADMIN_API_KEY_ENABLE=true  ADMIN_API_KEY=<secret>
DIFY_ADMIN_API_KEY=
DIFY_WORKSPACE_ID=

# Model rendered into Dify apps when publishing a prompt.
DIFY_DEFAULT_MODEL_CONFIG_JSON={"model": {"provider": "langgenius/openai_api_compatible/openai_api_compatible", "name": "qwen3.6", "mode": "completion", "completion_params": {}}}

# Own database (SQLite persisted on the named volume at /data).
DATABASE_URL=sqlite:////data/dify_hub.db

# Strong random secret for token encryption at rest. MUST be changed in production.
SECRET_KEY=change-me-to-a-strong-random-value

# Public run API rate limit (per key, per minute).
RATE_LIMIT_PER_MINUTE=60

# Front door (web) host port.
WEB_PORT=8100

# --- OpenAPI → MCP bridge ---
MCP_PUBLIC_HOST=127.0.0.1
MCP_BIND_HOST=0.0.0.0
MCP_PATH=/mcp
